{
  "functions": {
    "api/**/*.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/zalo/callback",
      "destination": "/api/zalo?__zalo_action=callback"
    },
    {
      "source": "/api/zalo/get-token",
      "destination": "/api/zalo?__zalo_action=get-token"
    },
    {
      "source": "/api/zalo/send",
      "destination": "/api/zalo?__zalo_action=send"
    },
    {
      "source": "/api/zalo/webhook",
      "destination": "/api/zalo?__zalo_action=webhook"
    }
  ]
}
